# ==============================================================================
# InvestOps - Environment Variables Configuration Template
# Copy this file to '.env' for local development:
#   cp .env.example .env (or 'copy .env.example .env' on Windows)
# DO NOT commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# PostgreSQL Database Configuration (Port 5434 avoids collisions with existing host services)
POSTGRES_DB=investops
POSTGRES_USER=investops_user
POSTGRES_PASSWORD=investops_password
POSTGRES_PORT=5434

# Spring Boot Backend Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
DB_HOST=localhost
DB_PORT=5434
DB_NAME=investops
DB_USERNAME=investops_user
DB_PASSWORD=investops_password

# JWT Security Configuration (256-bit secret key for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8081/api/v1
